{
  "name": "CustomLearningPath",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User for whom path was generated"
    },
    "user_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User's learning goals"
    },
    "skill_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string"
          },
          "current_level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "target_level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          }
        }
      },
      "description": "Identified skill gaps"
    },
    "recommended_courses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "number"
          },
          "course_title": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "estimated_weeks": {
            "type": "number"
          }
        }
      },
      "description": "AI-recommended course sequence"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "string"
          },
          "target_date": {
            "type": "string",
            "format": "date"
          },
          "courses_to_complete": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "skills_gained": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Learning milestones with timelines"
    },
    "total_estimated_hours": {
      "type": "number",
      "description": "Total hours to complete path"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "user_goals"
  ]
}