{
  "name": "UserEnrollment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of enrolled user"
    },
    "course_id": {
      "type": "number",
      "description": "Course ID"
    },
    "course_title": {
      "type": "string",
      "description": "Course title for quick reference"
    },
    "course_type": {
      "type": "string",
      "enum": [
        "coding",
        "art",
        "creator"
      ],
      "description": "Type of course"
    },
    "status": {
      "type": "string",
      "enum": [
        "enrolled",
        "in_progress",
        "completed"
      ],
      "default": "enrolled",
      "description": "Enrollment status"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "Overall completion percentage (0-100)"
    },
    "modules_completed": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "List of completed module indices"
    },
    "current_module": {
      "type": "number",
      "default": 0,
      "description": "Current module index (for continue watching)"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time",
      "description": "Last time user accessed this course"
    },
    "enrolled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When user enrolled"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When course was completed"
    },
    "total_modules": {
      "type": "number",
      "description": "Total number of modules in course"
    },
    "quiz_score": {
      "type": "number",
      "description": "Final quiz score (0-100)"
    },
    "certificate_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether certificate has been generated"
    },
    "estimated_hours": {
      "type": "number",
      "description": "Estimated total hours to complete course"
    },
    "actual_hours_spent": {
      "type": "number",
      "default": 0,
      "description": "Actual hours user has spent learning"
    },
    "learning_sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "minutes_spent": {
            "type": "number"
          },
          "module_index": {
            "type": "number"
          }
        }
      },
      "description": "Learning session history with timestamps"
    },
    "estimated_completion_date": {
      "type": "string",
      "format": "date",
      "description": "Projected completion date based on learning pace"
    },
    "learning_pace": {
      "type": "number",
      "description": "Hours per week learning pace"
    },
    "total_xp": {
      "type": "number",
      "default": 0,
      "description": "Total experience points earned"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current learning streak in days"
    },
    "last_learned_date": {
      "type": "string",
      "format": "date",
      "description": "Last day user logged learning time"
    },
    "perfect_quizzes": {
      "type": "number",
      "default": 0,
      "description": "Number of perfect quiz scores"
    },
    "failed_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topics user failed on quiz"
    }
  },
  "required": [
    "user_email",
    "course_id",
    "course_title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}