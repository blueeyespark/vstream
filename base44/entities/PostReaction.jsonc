{
  "name": "PostReaction",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the post being reacted to"
    },
    "author_email": {
      "type": "string",
      "description": "Email of user reacting"
    },
    "author_name": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "like",
        "love",
        "wow",
        "haha",
        "sad"
      ],
      "default": "like",
      "description": "Type of reaction"
    }
  },
  "required": [
    "post_id",
    "author_email",
    "reaction_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.author_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}