{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of certificate holder"
    },
    "user_name": {
      "type": "string",
      "description": "Name of certificate holder"
    },
    "course_id": {
      "type": "number",
      "description": "Course ID"
    },
    "course_title": {
      "type": "string",
      "description": "Course title"
    },
    "course_type": {
      "type": "string",
      "enum": [
        "coding",
        "art",
        "creator"
      ],
      "description": "Type of course"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date course was completed"
    },
    "final_score": {
      "type": "number",
      "description": "Final quiz score"
    },
    "certificate_url": {
      "type": "string",
      "description": "URL to download PDF certificate"
    },
    "certificate_id": {
      "type": "string",
      "description": "Unique certificate ID for verification"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When certificate was issued"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether certificate is publicly shareable"
    }
  },
  "required": [
    "user_email",
    "course_id",
    "course_title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}