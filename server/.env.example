PORT=8787
BLUE_WEB_ORIGIN=http://localhost:5173
BLUE_DATA_DIR=./.blue-data
BLUE_MAX_UPLOAD_BYTES=536870912

# Blue owns the AI boundary. Providers are replaceable.
# Values: none | ollama | openai-compatible
BLUE_AI_PROVIDER=none
# Ollama example: http://127.0.0.1:11434
# OpenAI-compatible example: https://api.openai.com/v1
BLUE_AI_BASE_URL=
BLUE_AI_MODEL=
# Required only for providers that use bearer API keys. Keep server-side.
BLUE_AI_API_KEY=
